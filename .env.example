# Copie este arquivo para .env e ajuste se precisar (o .env não vai para o Git).

# Conexão com o RabbitMQ (o docker-compose usa os mesmos valores para criar o usuário)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=ecommerce

# Pasta onde ficam as chaves de cada serviço
KEYS_DIR=keys
